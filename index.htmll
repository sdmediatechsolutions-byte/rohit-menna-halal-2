<script>

/* TELEGRAM LINK */

const TELEGRAM_LINK =
"https://t.me/+uHgTaOSc-r42YjU1";


/* META PIXEL CLICK TRACKING */

document
.querySelectorAll('.telegram-link, #telegramBtnSticky')
.forEach(function(button){

button.addEventListener('click',function(){

if(typeof fbq !== 'undefined'){

fbq(
'track',
'Lead',
{
content_name:'Hafiz Shakil Telegram Community',
value:'0.00',
currency:'INR'
}
);

}

});

});


/* COUNTDOWN */

let time = 30;

const countTxt =
document.getElementById('countTxt');

const countdown =
setInterval(function(){

time--;

if(countTxt){
countTxt.textContent = time;
}

if(time <= 0){

clearInterval(countdown);

if(countTxt){
countTxt.textContent = '0';
}

}

},1000);

</script>

